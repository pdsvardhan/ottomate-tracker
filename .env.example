# Ottomate tracker environment variables
# Copy to .env and fill in real values. .env is gitignored.

NODE_ENV=production
PORT=3000

# Database
DATABASE_URL=file:/app/data/ottomate.db

# API base
TRACKER_API_BASE=http://127.0.0.1:8110

# Bearer token for mutating endpoints (Codex Round 2)
# Generate via: openssl rand -hex 32 > .token
# (.token file gitignored; mounted as Docker secret in compose)
TRACKER_API_TOKEN_FILE=/run/secrets/tracker_token

# Optional: Tasks-dashboard webhook target (only if user opts in)
TASKS_DASHBOARD_API=https://tasks.vault7a.xyz/api
TASKS_DASHBOARD_TOKEN=

# Server access (skill side; tracker doesn't directly need)
# These live in skill plugin's credentials.md, NOT here
# SSH_HOST=192.0.2.10
# SSH_USER=pdsv

# Infisical (future — for centralizing secrets)
# INFISICAL_API_URL=
# INFISICAL_TOKEN=
